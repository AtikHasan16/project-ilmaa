# Supabase Client — anon key only. NEVER commit a service_role key here.
# Copy to .env and fill in your own values before running locally.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API & TTS Server (Local)
VITE_BACKEND_URL=http://localhost:5000

# Frontend URL (Local)
VITE_FRONTEND_URL=http://localhost:5173

# EmailJS Service Configuration
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key

# ImgBB image upload (avatar)
# cspell:ignore VITE
VITE_IMAGEBB_KEY=your-imgbb-api-key
